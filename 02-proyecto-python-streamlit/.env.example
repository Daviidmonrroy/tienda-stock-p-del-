# Copiar a .env y completar. El archivo .env NO se sube nunca al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vibra_deportiva
DB_USER=vibra
DB_PASSWORD=poner-una-clave-propia
DB_ROOT_PASSWORD=poner-otra-clave-propia
SQL_ECHO=false

# Usuarios que crea el script semilla (python -m scripts.semilla). Las claves están en scripts/semilla_usuarios.txt
ADMIN_EMAIL=admin@vibra.com
